{
  "description": "hikizan: condition-driven stops for git push, gh pr create, and submodule pointer integrity after commit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-push.sh"],
            "if": "Bash(git push*)",
            "timeout": 30,
            "statusMessage": "checking push preconditions..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-pr-create.sh"],
            "if": "Bash(gh pr create*)",
            "timeout": 15,
            "statusMessage": "checking PR create preconditions..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-commit.sh"],
            "if": "Bash(git commit*)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
