#!/usr/bin/env bash
# Check for wording that hikizan docs avoid in user-facing text.

set -euo pipefail

if ! command -v rg >/dev/null 2>&1; then
  echo "error: rg is required" >&2
  exit 2
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$ROOT" ]; then
  ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
fi

cd "$ROOT"

PATTERN='冪等|捨てた|すてた|起草|最小一歩|押し戻し'

targets=("$@")
if [ "${#targets[@]}" -eq 0 ]; then
  targets=(".")
fi

if rg -n --hidden \
  --glob '!.git/*' \
  --glob '!.worktrees/*' \
  --glob '!AGENTS.md' \
  --glob '!bin/check-terms' \
  "$PATTERN" \
  "${targets[@]}"; then
  echo "error: wording check found terms to rewrite" >&2
  exit 1
fi

echo "ok: wording check passed"
