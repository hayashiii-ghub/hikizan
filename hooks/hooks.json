{
  "description": "hikizan: lightweight skill routing, repository status, and a PR merge checkpoint.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-routing.sh", "claude"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-merge.sh"],
            "timeout": 10,
            "statusMessage": "checking PR merge..."
          }
        ]
      }
    ]
  }
}
