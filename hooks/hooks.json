{
  "description": "hikizan: condition-driven stops for git push, gh pr create, destructive Bash ops, and routing/tier context injected at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-context.sh"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-push.sh"],
            "if": "Bash(git push*)",
            "timeout": 30,
            "statusMessage": "checking push preconditions..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-pr-create.sh"],
            "if": "Bash(gh pr create*)",
            "timeout": 15,
            "statusMessage": "checking PR create preconditions..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-destructive.sh"],
            "if": "Bash(rm -*)",
            "timeout": 10,
            "statusMessage": "checking destructive op..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-destructive.sh"],
            "if": "Bash(git reset*)",
            "timeout": 10,
            "statusMessage": "checking destructive op..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-destructive.sh"],
            "if": "Bash(git clean*)",
            "timeout": 10,
            "statusMessage": "checking destructive op..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-destructive.sh"],
            "if": "Bash(git checkout*)",
            "timeout": 10,
            "statusMessage": "checking destructive op..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-command.sh"],
            "if": "Bash(git push*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-command.sh"],
            "if": "Bash(gh pr create*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-command.sh"],
            "if": "Bash(rm -*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-command.sh"],
            "if": "Bash(git reset*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-command.sh"],
            "if": "Bash(git clean*)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/post-command.sh"],
            "if": "Bash(git checkout*)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
