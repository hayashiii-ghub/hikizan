{
  "description": "hikizan: lightweight skill routing plus deterministic safety floors for push, PR creation, and destructive shell operations.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-routing.sh", "claude"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-push.sh"],
            "timeout": 30,
            "statusMessage": "checking push preconditions..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-pr-create.sh"],
            "timeout": 15,
            "statusMessage": "checking PR create preconditions..."
          },
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/pre-destructive.sh"],
            "timeout": 10,
            "statusMessage": "checking destructive op..."
          }
        ]
      }
    ]
  }
}
