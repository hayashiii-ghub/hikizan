{
  "description": "hikizan: lightweight skill routing and repository status.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-routing.sh", "claude"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
