{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/scripts/session-routing.sh codex",
            "statusMessage": "loading hikizan skill routing..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ${PLUGIN_ROOT}/hooks/scripts/pre-merge.sh deny Codex", "statusMessage": "checking PR merge..." }
        ]
      }
    ]
  }
}
